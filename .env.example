# Never commit real credentials. Credentials are supplied per request by the backend caller.
ORACLE_LOGIN_URL=https://oracleapex.com/ords/r/drmworkspace/timesheet-application/login
# ORACLE_BASE_URL=https://oracleapex.com/ords/r/drmworkspace/timesheet-application/login
PORT=8787
HEADLESS=true
AUTOMATION_READ_ONLY=true
ORACLE_WRITE_ENABLED=false
ARTIFACT_DIR=backend/artifacts
POST_LOGIN_CAPTURE_MS=3000
LOGIN_VERIFICATION_TIMEOUT_MS=15000
ORACLE_FORM_READY_DELAY_MS=3000
ORACLE_NAVIGATE_TIMESHEET=true
ORACLE_NAVIGATION_MENU_SELECTOR=#t_Button_navControl
TIMESHEET_NAVIGATION_TIMEOUT_MS=15000

# Adjust these only if the deployed APEX page uses different selectors.
# ORACLE_USERNAME_SELECTOR=input[name="username"], input[name="p_username"], input[type="email"], input[placeholder="Username"], input[aria-label="Username"]
# ORACLE_PASSWORD_SELECTOR=input[name="password"], input[name="p_password"], input[type="password"], input[placeholder="Password"], input[aria-label="Password"]
# ORACLE_LOGIN_BUTTON_SELECTOR=button[type="submit"], input[type="submit"], button:has-text("Sign In"), input[value="Sign In"]
# The authenticated APEX page exposes this main content region after login.
# Verification also requires the login form to disappear; this prevents the
# shared APEX main container on the login page from being a false positive.
# ORACLE_AUTHENTICATED_SELECTOR=main#mainContent
# Use the stable path only. Never include a session query parameter.
# ORACLE_AUTHENTICATED_PATHS=/ords/r/drmworkspace/timesheet-application/home,/ords/r/drmworkspace/timesheet-application/home1
# ORACLE_LOGIN_ERROR_SELECTOR=
